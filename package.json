{
  "name": "@radixing/traffic-engine",
  "version": "1.2.0",
  "description": "Deterministic traffic distribution system with automatically refreshed open network and user-agent data",
  "type": "module",
  "license": "MIT",
  "repository": "github:imphillip/radixing-traffic-engine",
  "homepage": "https://radixing.com",
  "keywords": [
    "traffic-routing",
    "policy-engine",
    "conditional-delivery",
    "traffic-cloaking",
    "bot-detection",
    "fingerprinting",
    "tds",
    "waf",
    "edge-computing"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "bin": {
    "radixing-tds": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "scripts/build.mjs",
    "tsconfig*.json",
    "src",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "prepare": "npm run build",
    "data:sync": "node dist/cli.js sync",
    "start": "node dist/cli.js serve"
  },
  "dependencies": {
    "bowser": "2.14.1",
    "csv-parse": "7.0.3",
    "ipaddr.js": "2.5.0",
    "re2js": "2.8.6",
    "structured-headers": "2.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.1",
    "miniflare": "5.20261006.1-alpha",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
